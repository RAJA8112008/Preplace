# ==========================================
# PREPLACE BACKEND ENVIRONMENT TEMPLATE (.env)
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# JWT Authentication Secret & Token Expiry
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# MongoDB Connection String (Compass / Local MongoDB / MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/preplace
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/preplace?retryWrites=true&w=majority

# ==========================================
# EMAIL SERVICE (Brevo / Sendinblue)
# ==========================================

# Sender Details
BREVO_SENDER_EMAIL=officialraja421@gmail.com
BREVO_SENDER_NAME=PrePlace

# Brevo SMTP Configuration (From Brevo Dashboard -> SMTP & API)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login@smtp-brevo.com
SMTP_PASS=xsmtpsib-your-smtp-key-here

# Optional: Brevo v3 REST API Key (Starts with xkeysib-...)
# BREVO_API_KEY=xkeysib-your-api-key-here
