PORT=5000
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/preplace
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/preplace?retryWrites=true&w=majority

# Optional SMTP Settings for sending real email OTPs
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Preplace Auth" <noreply@preplace.com>
